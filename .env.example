# Core
MARKET_ATLAS_DB_PATH=data/market_atlas.duckdb
MARKET_ATLAS_TIMEFRAME=1d
MARKET_ATLAS_DEFAULT_START_DATE=2024-01-01

# Universe
MARKET_ATLAS_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MARKET_ATLAS_EQUITY_SYMBOLS=SPY,QQQ,TLT,DX-Y.NYB,GLD,SLV,CL=F

# News / OSINT
MARKET_ATLAS_NEWS_QUERY=(crypto OR equities OR macro OR fed OR oil OR liquidity)
GITHUB_TOKEN=  # optional but recommended to avoid GitHub API rate limiting

# Strategy + costs
MARKET_ATLAS_FEE_BPS=6.0
MARKET_ATLAS_SLIPPAGE_BPS=5.0
MARKET_ATLAS_BASE_CAPITAL=10000

# Existing infra bridge (optional)
SAPPHIRE_GATEWAY_URL=
SAPPHIRE_ALPHA_URL=
SAPPHIRE_CONTROL_API_TOKEN=
